{
  "name": "@actionharbor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Gate 9 operator UI: the ActionHarbor run control room. Renders proposal, policy decision, approval, capability (safe metadata only), execution, verification, and the audit timeline for real runs served by apps/server — never a mocked or hard-coded state.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@actionharbor/contracts": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.13",
    "vitest": "^4.1.10"
  }
}
